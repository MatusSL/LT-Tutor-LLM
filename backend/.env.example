# Auth for the FastAPI endpoints (clients send this as the X-API-Key header)
API_KEY=replace-with-a-long-random-string

# OpenAI (used for tutor/reviewer models and Whisper STT)
OPENAI_API_KEY=sk-...

# Supabase (PostgreSQL backend for vocabulary + sessions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-or-anon-key

# Local LLM endpoint (e.g. LM Studio). Falls back to these defaults if unset.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-3-12b

# Server bind address (defaults to 0.0.0.0:8000 if unset)
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional
LOG_LEVEL=INFO
