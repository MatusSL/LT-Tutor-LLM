# Auth for the FastAPI endpoints (clients send this as the X-API-Key header)
API_KEY=replace-with-a-long-random-string

# OpenAI (used for tutor/reviewer models and Whisper STT)
OPENAI_API_KEY=sk-...

# Supabase (PostgreSQL backend for vocabulary + sessions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-or-anon-key

# Optional
LOG_LEVEL=INFO
